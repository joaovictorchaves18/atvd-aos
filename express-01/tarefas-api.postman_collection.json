{
  "info": {
    "name": "API Tarefas - AOS 2026.2",
    "description": "Coleção Postman para testar os endpoints CRUD de /tarefas no back-end publicado na Vercel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://seu-backend.vercel.app",
      "type": "string"
    },
    {
      "key": "objectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Criar Tarefa (POST /tarefas)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const data = pm.response.json();",
              "if (data && data.objectId) {",
              "  pm.collectionVariables.set('objectId', data.objectId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Estudar Node.js, Express, Sequelize e Zod\",\n  \"concluida\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "2. Listar Tarefas (GET /tarefas)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is an array', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "3. Buscar Tarefa por ID (GET /tarefas/:objectId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "4. Atualizar Tarefa (PUT /tarefas/:objectId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Tarefa atualizada via Postman\",\n  \"concluida\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "5. Remover Tarefa (DELETE /tarefas/:objectId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        }
      }
    }
  ]
}
